# OKX Developer Portal credentials (https://web3.okx.com/onchainos/dev-portal)
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Local HMAC key for signing 402 challenges. Generate: openssl rand -base64 32
MPPX_SECRET_KEY=

# "testnet" (X Layer testnet, chain 1952) or "mainnet" (X Layer, chain 196)
NETWORK=testnet

# Public hostname of this proxy (used as realm and in generated docs)
PUBLIC_URL=http://localhost:3000
PORT=3000

# Default receiving wallet for demo services (each business can override payTo)
DEFAULT_PAY_TO=0x0000000000000000000000000000000000000000

# --- Optional ---
# LLM for find-test, listing fixes and Assist matching (falls back to heuristics without it)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Vendo Assist buyer wallet (funded X Layer wallet that pays for Assist tasks) and limits
BUYER_PRIVATE_KEY=
ASSIST_MAX_USD_PER_CALL=0.1
ASSIST_MAX_USD_PER_DAY=2

# --- Listing models ---
# Wallet that receives revenue for stores Vendo lists on the business's behalf ("managed")
VENDO_TREASURY_WALLET=
# Default Vendo fee for managed stores, in basis points (1000 = 10%)
VENDO_FEE_BPS=1000
# Key for encrypting business API credentials at rest (falls back to MPPX_SECRET_KEY)
VENDO_ENCRYPTION_KEY=

# --- Treasury vault (optional) ---
XLAYER_RPC=
VAULT_ADDRESS=
OPERATOR_PRIVATE_KEY=

# --- Operations ---
HEALTH_CHECK_MINUTES=10
BILL_CHECK_MINUTES=30
# Optional fee split on self-listed stores via the MPP engine (basis points, sent to VENDO_TREASURY_WALLET)
VENDO_SPLIT_FEE_BPS=0

# --- Security (required in production) ---
NODE_ENV=production
# Protects dashboard, treasury, payouts and bills APIs
VENDO_ADMIN_TOKEN=
# Lets the Assist extension run paid tasks (falls back to the admin token)
VENDO_ASSIST_TOKEN=
# Ed25519 private key (PKCS8 PEM, base64) for signed delivery receipts; generated into data/ if empty
VENDO_RECEIPT_KEY=
# Call pack discount (0.15 = 15% off)
VENDO_PACK_DISCOUNT=0.15

# --- Finance data ---
# Required by SEC EDGAR fair access rules: "AppName contact@email"
SEC_USER_AGENT=
# Optional override for the OFAC SDN CSV location
OFAC_SDN_URL=
